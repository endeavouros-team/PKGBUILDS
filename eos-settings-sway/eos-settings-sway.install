post_install() {
    local config_file="/etc/greetd/config.toml"
    local target_cmd="command = \"tuigreet --time --time-format '%d.%m.%Y - %H:%M:%S' --greeting 'Welcome to EndeavourOS' --remember --asterisks --width 70 --container-padding 3 --prompt-padding 2 --user-menu --theme 'container=black;border=gray;text=white;input=white;prompt=magenta;time=magenta;action=white;button=magenta' --cmd eos-sway-wrapper\""

    if [ -f "$config_file" ]; then
        echo "==> Configuring greetd/tuigreet for EndeavourOS Sway..."
        sed -i 's|^command = .*|'"$target_cmd"'|' "$config_file"
    fi
}

post_upgrade() {
    post_install
}
