#!/bin/bash

Main() {
    local appId="$1"                  # e.g. "eos-update"
    local langHint="$2"               # e.g. "en" or "en_US"; "" means "en_US"; must be a unique head part!
    local extraopts="$3"
    local -r progname=${0##*/}
    local langfile=""
    local ll
    local -r fallbackLang=en_US

    [ "$appId" ] || DIE "parameter <appname> is missing"
    
    case "$langHint" in
        C | "") langHint="$fallbackLang"
                Find langfile "$langHint" || exit 1
                ;;
        *)
            if ! Find langfile "$langHint" ; then
                Find langfile "$fallbackLang" || exit 1
            fi
            ;;
    esac

    echo -n "$langfile"
}

DIE() {
    local -r msg="$1"
    echo2 "$progname: error: $msg\n"
    # Usage
    exit 1
}
Usage() {
    cat <<EOF >&2
Usage: $progname <app-name> [<lang>]
  <appname>    Name (id) of the app subject to language translation, e.g. 'eos-update'.
  <lang>       Optional language spec, e.g. '$fallbackLang' or 'sv_SE'. Defaults to '$fallbackLang'.
EOF
}
echo2() { echo -e "$@" >&2; }

Find() {
    local -n _retvar="$1"
    local langHint="$2"
    local -r trdir="/usr/share/endeavouros/translations"
    local -r searchItem="$trdir/btr_${appId}_$langHint"
    local translations=("${searchItem}"*)     # use given lang tip
    local -r conffile=/etc/bash-app-translate.conf

    case "${translations[0]}" in
        *\*)
            case "$extraopts" in
                --quiet-fallback) ;;
                *)
                    [ -e $conffile ] && source $conffile
                    case "$BTR_WARN_ABOUT_MISSING_TRANSLATION" in
                        "" | yes)
                            [ "$langHint" != "$fallbackLang" ] && echo2 "==> Translation file '${searchItem}*' not found. Falling back to $fallbackLang."
                            ;;
                    esac
                    ;;
            esac
            return 1
            ;;
        *)
            if [ "${#translations[@]}" -eq 1 ] ; then
                _retvar="${translations[0]}"
            else
                case "$extraopts" in
                    --quiet-fallback) ;;
                    *)
                        [ -e $conffile ] && source $conffile
                        case "$BTR_WARN_ABOUT_MISSING_TRANSLATION" in
                            "" | yes)
                                local tmp=""
                                printf -v tmp "  %s\n" "${translations[@]}"
                                echo2 "==> Multiple translation file matches:\n${tmp}Please check your language definition."
                                [ "$langHint" != "$fallbackLang" ] && echo2 "Falling back to $fallbackLang."
                                ;;
                        esac
                        ;;
                esac
                return 1
            fi
            ;;
    esac
}

Main "$@"
