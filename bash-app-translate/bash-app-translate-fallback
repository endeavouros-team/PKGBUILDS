#!/bin/bash

Main() {
    local appId="$1"                  # e.g. "eos-update"
    local langHint="${2:-en_US}"      # e.g. "en" or "en_US"; "" means "en_US"; must be a unique head part!
    local -r progname=${0##*/}
    local langfile=""

    [ "$appId" ] || DIE "parameter <appname> is missing"

    Find langfile "$langHint" || exit 1
    echo -n "$langfile"
}

DIE() {
    local -r msg="$1"
    echo2 "$progname: error: $msg\n"
    # Usage
    exit 1
}
Usage() {
    cat <<EOF >&2
Usage: $progname <app-name> [<lang>]
  <appname>    Name (id) of the app subject to language translation, e.g. 'eos-update'.
  <lang>       Optional language spec, e.g. 'en_US' or 'sv_SE'. Defaults to 'en_US'.
EOF
}
echo2() { echo -e "$@" >&2; }

Find() {
    local -n _retvar="$1"
    local langHint="$2"
    local -r trdir="/usr/share/endeavouros/translations"
    local -r searchItem="$trdir/btr_${appId}_$langHint"
    local translations=("${searchItem}"*)     # use given lang tip

    case "${translations[0]}" in
        *\*)
            DIE "translation file problem:\n-> '${searchItem}*' matches nothing.\nPlease check your language definition."
            ;;
        *)
            if [ "${#translations[@]}" -eq 1 ] ; then
                _retvar="${translations[0]}"
            else
                local tmp=""
                printf -v tmp "  %s\n" "${translations[@]}"
                DIE "multiple translation file matches:\n${tmp}Please check your language definition."
            fi
            ;;
    esac
}

Main "$@"
