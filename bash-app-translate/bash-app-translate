#!/bin/bash

BTR_printf() {
    local fmt="$1"
    local arg
    shift
    for arg in "$@" ; do
        fmt=${fmt/\%s/$arg}
    done
    echo -n "$fmt"
}

_BTR_MULTILINE_() {   # NOT TESTED YET!!
    # Note: %s is NOT supported here!
    local -n _btr_array_arg_="$1"
    local line
    shift
    for line in "${_btr_array_arg_[@]}" ; do
        printf "%s\n" "$line"                  # without "%s\n" newlines are consumed...
    done
}

# An app can use function BTR for translation strings.
# %s in te string can be used for parameters (because of printf below).
#
BTR() {
    local akey="$1"
    local contents="${BTR_ARR[$akey]}"
    shift
    case "$contents" in
#        _MULTILNE_*)
#            # Parameters NOT supported!
#            _BTR_MULTILINE_ "$contents"
#            ;;
        *)
            # printf "${BTR_ARR[$akey]}" "$@"
            BTR_printf "${BTR_ARR[$akey]}" "$@"
            ;;
    esac
}

# Language identifier is reduced from the value of the $LANG environment variable.
# This id is used in the names of the translation files.
# Note: this implementation is not anywhere near complete...
#
_btr_get_lang_() {
    # See: /usr/share/i18n/locales
    case "$LANG" in
        nl_NL* | pt_BR* | uk_UA* | zh_CN* | zh_HK* | zh_SG* | zh_TW*)
            echo ${LANG::5} ;;
        *)
            echo ${LANG::2} ;;
    esac
}


# Some definitions that may be needed in the translations:
BTR_exclamation='&#33;'         # '!'
BTR_and='&#38;'                 # '&'
BTR_question='&#63;'            # '?'
BTR_exclamation_down='&#161;'   # '¡'
BTR_question_down='&#191;'      # '¿'


# Grab the proper BTR_ARR contents for the app & language.
#
source "/usr/share/endeavouros/translations/btr_$1_$(_btr_get_lang_)" || exit 1
