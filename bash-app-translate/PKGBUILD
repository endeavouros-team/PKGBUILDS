#!/bin/bash
# Maintainer: EndeavourOS-Team <info@endeavouros.com>

# shellcheck disable=2034,2154

pkgname=bash-app-translate
pkgdesc="Add translation support for bash language apps"
pkgver=26.1.7
pkgrel=1
arch=('any')
license=('GPL')
depends=(bash)
optdepends=()
backup=("etc/$pkgname.conf")
url=https://github.com/endeavouros-team/PKGBUILDS/tree/master/$pkgname
_url="https://raw.githubusercontent.com/endeavouros-team/PKGBUILDS/master/$pkgname"

source=(
    "$_url/$pkgname"                        # contains functions needed for translations
    "$_url/$pkgname.md"                     # user guide
    "$_url/$pkgname.conf"                   # user configurations
    "$_url/get-legacy-id-lang-translation"  # uses the legacy (Welcome's) implementation
)
sha512sums=('c7c057b7c62007082a874d24294c93c2480e9952006f592ca8ef4673d05dafa16ae1d8152e87d627ff18e03e411de281c630ce255ebefc25fed179e9fcd7f379'
            'f99231e0101abd6bd088e8b978a3d02f39a02afa770ce53b89aaef2a7ab341e902e43fdd49ce1585328479b1e63058ff3ada1078563a461e8a1876a0aa1450aa'
            '169b40bf7dba229b59d6131f98abd889cf773fe766e743e8e99ae7c382c3ff32b3ba2bed048f01bf094f1dace8e96a184710e6a62a6207c529e6636195821ed9'
            '7a0f882797b0592e2030c232dfdecd4d6246ff452889dfb44bd4f2122bf584e62380e9d870713ccba28a6eff0380a3da3b5885ca9021749acb9488a86a413b34')

package() {
    local src file
    for src in "${source[@]}" ; do
        file=${src##*/}
        case "$file" in
            *.conf)   install -Dm644 "$file"   "$pkgdir/etc/$file" ;;
            *.md)     install -Dm644 "$file"   "$pkgdir/usr/share/doc/$pkgname/$file" ;;
            get-legacy-id-lang-translation)
                      install -Dm755 "$file"   "$pkgdir/usr/bin/$file" ;;
            *)        install -Dm644 "$file"   "$pkgdir/usr/share/endeavouros/translations/$file" ;;
        esac
    done
}
