#!/bin/bash
# Maintainer: EndeavourOS-Team <info@endeavouros.com>

# shellcheck disable=2034,2154

pkgname=akm
pkgdesc="Arch kernel manager."
url=https://github.com/endeavouros-team/PKGBUILDS/tree/master/$pkgname
_url="https://raw.githubusercontent.com/endeavouros-team/PKGBUILDS/master/$pkgname"
pkgver=26.11.2
pkgrel=1
arch=('any')
license=('GPL')
depends=(eos-bash-shared yad bash-app-translate)
backup=("etc/$pkgname.conf")

source=(
    "$_url/$pkgname"
    "$_url/$pkgname.conf"
    "$_url/$pkgname.desktop"
    "btr_${pkgname}_en_US"
    "btr_${pkgname}_cs_CZ"
    "btr_${pkgname}_fi_FI"
    "btr_${pkgname}_sk_SK"
)
sha512sums=('ed884c233e8a706d1708dcbc85185feb175c90243fd089295ec81850ca09de4181744777034fa0446cb9c8a25ddf2c5f70a45ac7f47c0f2180c22ed93bfebc32'
            '9ab486eaa58857dfaf1d3b3838768b9c629f65709177544ad4602daf2752be9709a529abba359fe984a9f231688ae30bb7aa3df97a2c8d88fbb37742f5fd26f7'
            '1f2c9d47d3731aa1296c9760f388433d49e99c5a3e3dc2f02c3430f68559590d8f673c221c03a68140389a0582054fb2cf5b9bcf66e7a9ed34b4014ac67e15ae'
            'e8dc693d506d38152008cdb448c46472f03809ee4c85d071aad069dd722e51981dd40f6cb8727e2ffb857cc810be88935ebc9838597098ce0e03a56a43049117'
            'd5947efa99fa36c9f12a4277d34062eb675b04d0043f73e971ea65f9afbcc462bae5923dfc3c0342afba46185780a3fe9e23fe420f53f47906f9020c932cded1'
            '32f5ccbee369b3231e73e28e5aeb407cbabb23e3bc99dc54ebc21323b0f23334883839d6737caab600165dc1ad7ab33f882dd4d72541a8866320ea0bfe944e08'
            '67c3abdc23041efedd3487c1a1957b020c2f4cff919e2c99844d10523fe44691f8f47d20b60efc8633c1d1a3b7520abc49a054d02752bd024faeb2358f74f54e')

package() {
    local src file
    for src in "${source[@]}" ; do
        file=${src##*/}
        case "$file" in
            *.conf)            install -Dm644 "$file"    "$pkgdir/etc/$file" ;;
            *.desktop)         install -Dm644 "$file"    "$pkgdir/usr/share/applications/$file" ;;
            btr_${pkgname}_*)  install -Dm644 "$file"    "$pkgdir/usr/share/endeavouros/translations/$file" ;;
            *)                 install -Dm755 "$file"    "$pkgdir/usr/bin/$file" ;;
        esac
    done
}
