#!/bin/bash
# Maintainer: EndeavourOS-Team <info@endeavouros.com>

# shellcheck disable=2034,2154

pkgname=akm
pkgdesc="Arch kernel manager."
url=https://github.com/endeavouros-team/PKGBUILDS/tree/master/$pkgname
_url="https://raw.githubusercontent.com/endeavouros-team/PKGBUILDS/master/$pkgname"
pkgver=26.9.2
pkgrel=1
arch=('any')
license=('GPL')
depends=(eos-bash-shared yad bash-app-translate)
backup=("etc/$pkgname.conf")

source=(
    "$_url/$pkgname"
    "$_url/$pkgname.conf"
    "$_url/$pkgname.desktop"
    "btr_${pkgname}_en_US"
    "btr_${pkgname}_fi_FI"
)
sha512sums=('65b1083761204839e52a3bb00f8aa85317f1cd6b01e427ccee19a69cf383ecda687905456532817f4ca8aea4187717514a5e2b71aeab55d759833fd5b41e7f15'
            '9ab486eaa58857dfaf1d3b3838768b9c629f65709177544ad4602daf2752be9709a529abba359fe984a9f231688ae30bb7aa3df97a2c8d88fbb37742f5fd26f7'
            '461e66cadd3e6c7c909e88778419f074a7f659fc38d285a6d0b988533c1f139bfba7c15c0f620a31923e558a1ec6609a588c806c68f6c1dc3fdc218b0f42dc5f'
            '4e3cc7bd189e37f4a2a9126b5ed45331a69e50bbab66e511f57c0a1b21905a962c62bfc1e5db1c7486a752abb4130dd6f47e7fbde69e0e9e4522f525d4b3321a'
            '16d268f9998c76835d6a487e9906442da6e925387fe8e500156c6b900ae6d53535955410f8e6cdf23551394e3fdf9619398cdbbc9c4282acc79ca32b5b7c0e65')

package() {
    local src file
    for src in "${source[@]}" ; do
        file=${src##*/}
        case "$file" in
            *.conf)            install -Dm644 "$file"    "$pkgdir/etc/$file" ;;
            *.desktop)         install -Dm644 "$file"    "$pkgdir/usr/share/applications/$file" ;;
            btr_${pkgname}_*)  install -Dm644 "$file"    "$pkgdir/usr/share/endeavouros/translations/$file" ;;
            *)                 install -Dm755 "$file"    "$pkgdir/usr/bin/$file" ;;
        esac
    done
}
