#!/bin/bash

Line2()   { echo "$@" >&2 ; }
Printf2() {
    # shellcheck disable=2059
    printf "$@" >&2
}
Verbose2() { [ $quiet = no ] && Line2 "$@"; }

FormatVersion()     { printf "%s%s  " "$1" "$2" ; }
FormatName()        { FormatVersion "$1" ; }

Header() {
    local fname="${FUNCNAME[1]}"
    case "$fname" in
        Choose)    fname="$(BTR akm_title_choose)" ;;
        PkgName)   fname="$(BTR akm_title_pkgname)" ;;
        Installed) fname="$(BTR akm_title_installed)" ;;
        Stable)    fname="$(BTR akm_title_stable)" ;;
        Testing)   fname="$(BTR akm_title_testing)" ;;
        KernelOrg) fname="$KOName" ;;
        KOVersion) fname="$KOVersionName" ;;
    esac
    local hdr="<b>$fname</b>"

    if [ "$fname" = "$RepoType" ] ; then
        hdr="<i>$hdr</i>"                    # currently used repo: italics font
    fi
    FormatVersion "$hdr"
}

LocalVersion() {
    local pkg="${1##*/}"
    [ "${LocalPkgVersions[$pkg]}" ] || LocalPkgVersions[$pkg]=$(expac -Q %v "$pkg")
    echo "${LocalPkgVersions[$pkg]}"
}

Choose() {
    local version exist xx
    cmd+=(--field="${smallBegin}$(Header)${smallEnd}!$(BTR op_choose_tip)":LBL "")
    for xx in "${kernels[@]}" ; do
        version="$(LocalVersion "$xx")"
        [ "$version" ] && exist=TRUE || exist=FALSE
        cmd+=(--field="":CHK "$exist")   # Field has one space, workaround for a yad bug.
                                         # Fixed in yad 7.2-1, removed workaround.
    done
}

PkgName() {
    local xx
    cmd+=(--field="${smallBegin}$(Header)${smallEnd}!$(BTR op_pkgname_tip)":LBL "")
    for xx in "${kernels[@]}" ; do
        cmd+=(--field="${smallBegin}$(FormatName "$xx")${smallEnd}":LBL "")
    done
}

Installed() {
    local version xx
    local kernel
    kernel=$(eos_running_kernel)
    case "$kernel" in
        linux*) ;;
        *) DIE "$(BTR die_internal_error)" ;;
    esac
    local running
    running=$(expac -Q %v "$kernel")
    local ind1 ind2 type
    cmd+=(--field="${smallBegin}$(Header)${smallEnd}!$(BTR op_installed_tip)":LBL "")
    for xx in "${kernels[@]}" ; do
        version="$(LocalVersion "$xx")"
        ind1=""
        ind2=""
        if [ "$version" = "$running" ] ; then
            case "$xx" in
                *-headers) ;;
                *) ind1="<i>"; ind2="</i>" ;;       # currently running kernel: italics font
            esac
        fi
        case "$xx" in
            */linux | */linux-headers) type=stable ;;
            */linux-lts*)              type=longterm ;;
            *)                         type="" ;;
        esac
        if IsLatestKO "$version" "$type" ; then
            cmd+=(--field="${smallBegin}$(FormatVersion "$ind1<b>$version</b>$ind2")${smallEnd}":LBL "")
        else
            cmd+=(--field="${smallBegin}$(FormatVersion "$ind1$version$ind2")${smallEnd}":LBL "")
        fi
    done
}

StableVersions() {
    local pkg pkgs=()

    for pkg in "${kernels[@]}" ; do
        # prevent usage of the '*-testing' repos:
        case "$pkg" in
            linux | linux-headers | linux-lts | linux-lts-headers)
                pkgs+=("core/$pkg") ;;
            linux-zen | linux-zen-headers | linux-hardened | linux-hardened-headers | linux-rt | linux-rt-headers | linux-rt-lts | linux-rt-lts-headers)
                pkgs+=("extra/$pkg") ;;
            core/linux* | extra/linux*)
                pkgs+=("$pkg") ;;
        esac
    done
    readarray -t versions < <(expac -S %v "${pkgs[@]}")
}

Stable() {
    local version in_use=""
    if [ "${FUNCNAME[0]}" = "$RepoType" ] ; then
        in_use="$(BTR op_in_use)"
    fi
    cmd+=(--field="${smallBegin}$(Header)${smallEnd}!$(BTR op_versions_tip "Stable" "$in_use")":LBL "")
    local versions=() ix=0
    StableVersions
    for ((ix=0; ix < ${#kernels[@]}; ix++)) ; do
        version="${versions[$ix]}"
        cmd+=(--field="${smallBegin}$(FormatVersion "$version")${smallEnd}":LBL "")
    done
}

TestingVersion() {
    local pkg="${1##*/}"
    if true ; then
        local tmp="$testinginfo"
        tmp=$(echo "$tmp" | grep -A2 "/packages/core-testing/x86_64/$pkg/")
        if [ "$tmp" ] ; then
            tmp=$(echo "$tmp" | tail -n1)
            tmp=$(echo "$tmp" | sed -E 's|.*>([0-9][0-9a-z\.\-]+)<.*$|\1|')
        fi
        echo "$tmp"
    else
        echo "$testinginfo" | grep -A2 "/packages/core-testing/x86_64/$pkg/" | tail -n 1 | sed -E 's|.*>([0-9][0-9a-z\.\-]+)<.*$|\1|'
    fi
}

UNAVAILABLE() { DIE "$(BTR item_not_available "$1" "$2")" ; }

Testing() {
    local in_use=""
    if [ "${FUNCNAME[0]}" = "$RepoType" ] ; then
        in_use="$(BTR op_in_use)"
    fi
    local URL="https://archlinux.org/packages/?repo=Core-Testing&q=linux+kernel+and+modules"
    local testinginfo
    local version xx

    # shellcheck disable=2086
    testinginfo="$(/usr/bin/curl --fail -Ls $URL_timeout "$URL")" || UNAVAILABLE "${URL%%/packages*}"

    [ -n "$testinginfo" ] || DIE "$(BTR die_arch_fail)"

    cmd+=(--field="${smallBegin}$(Header)${smallEnd}!$(BTR op_versions_tip "Testing" "$in_use")":LBL "")
    for xx in "${kernels[@]}" ; do
        version="$(TestingVersion "$xx")"
        test -n "$version" || version="$na"
        cmd+=(--field="${smallBegin}$(FormatVersion "$version")${smallEnd}":LBL "")
    done
}

KernelOrgVersion() {
    local type="$1"
    local count="$2"
    [ -n "$count" ] || count=1
    local result1
    result1="$(echo "$kernelorg" | grep -A2 "$type:" | grep -v EOL | grep strong | sed -e 's|^.*<strong>||' -e 's|</strong>.*$||')"
    case "$type" in
        mainline) ;;
        longterm) result1="$(echo "$result1" | head -n "$count")" ;;
        *) result1="$(echo "$result1" | grep -v "[0-9][0-9\.]*-rc")" ;;
    esac
    echo "$result1"
}

KernelOrg() {
    local version versions xx count=${#kernels[@]}
    cmd+=(--field="${smallBegin}$(Header)${smallEnd}!$(BTR op_ko_tip)":LBL "")
    for xx in "${org_kernels[@]}" ; do
        readarray -t versions < <(KernelOrgVersion "$xx")
        for version in "${versions[@]}" ; do
            cmd+=(--field="${smallBegin}$(FormatName "$xx")${smallEnd}":LBL "")
            ((count--))
        done
    done
    PaddingLines "$count"
}

KOVersion() {
    local version versions xx count=${#kernels[@]}
    cmd+=(--field="${smallBegin}$(Header)${smallEnd}!$(BTR op_ko_latest)":LBL "")
    for xx in "${org_kernels[@]}" ; do
        readarray -t versions < <(KernelOrgVersion "$xx")
        case "$xx" in
            stable|longterm)
                for version in "${versions[@]}" ; do
                    cmd+=(--field="${smallBegin}$(FormatVersion "<b>$version</b>")${smallEnd}":LBL "")
                    ((count--))
                done
                ;;
            *)
                for version in "${versions[@]}" ; do
                    cmd+=(--field="${smallBegin}$(FormatVersion "$version")${smallEnd}":LBL "")
                    ((count--))
                done
                ;;
        esac
    done
    PaddingLines "$count"
}

IsLatestKO() {
    local installed_version="$1"
    local type="$2"

    case "$type" in
        stable | longterm)
            local versions version=()
            installed_version="$(echo "$installed_version" | sed -e 's|-.*||' -e 's|\.[a-z].*||')"   # skip Arch suffixes
            readarray -t versions < <(KernelOrgVersion "$type" 100)
            for version in "${versions[@]}" ; do
                [ "$installed_version" = "$version" ] && return 0
            done
            ;;
    esac
    return 1
}

PaddingLines() {
    local count="$1"
    local xx
    for ((xx=0; xx<count; xx++)) ; do
        cmd+=(--field="${smallBegin}$(FormatVersion "")${smallEnd}":LBL "")
    done
}


# Export these small functions:
Changelog() { xdg-open "$(eos-github2gitlab https://github.com/endeavouros-team/PKGBUILDS/commits/master/akm)"; }
Manual()    { eos-apps-info-helper akm; }

CommonStuff() {
    local EOS_SCRIPTS_YAD=/usr/share/endeavouros/scripts/eos-script-lib-yad
    if [ ! -f $EOS_SCRIPTS_YAD ] ; then
        Line2 "$(BTR msg_not_installed "eos-bash-shared")"
        exit 1
    fi
    # shellcheck disable=1090
    source $EOS_SCRIPTS_YAD
    export -f eos_yad
    export -f eos_yad_RunCmdTermBash
    export -f eos_yad_terminal
    AssignIconVariables_in_eos_bash_shared
    export -f Changelog Manual
}

AkmConfig() {
    local conf=/etc/akm.conf
    if [ -f $conf ] ; then
        # shellcheck disable=1090
        source $conf

        [ -n "$KERNEL_HEADER_WITH_KERNEL" ] && connect_header_with_kernel="$KERNEL_HEADER_WITH_KERNEL"
        [ -n "$AKM_KERNELS_HEADERS" ]       && akm_kernels_headers_user=("${AKM_KERNELS_HEADERS[@]}")
        [ -n "$AKM_WINDOW_WIDTH" ]          && akm_window_width=$AKM_WINDOW_WIDTH
        [ -n "$AKM_PREFER_SMALL_WINDOW" ]   && small_font=$AKM_PREFER_SMALL_WINDOW

        Options "$@"
        Verbose2 "==> Config file $conf read."
    else
        Options "$@"
    fi
}

DIE() {
    eos_yad --form --width=400 --title="AKM message" --image="$ICO_ERROR" --text="$1" --button=yad-quit
    exit 1
}

UniqueArr() {
    # remove duplicates from an array 'arr'
    local -n arr=$1
    local to=()
    local xx yy

    for xx in "${arr[@]}" ; do
        for yy in "${to[@]}" ; do
            [ "$xx" = "$yy" ] && break
        done
        [ "$xx" != "$yy" ] && to+=("$xx")
    done
    arr=("${to[@]}")
}

Options() {
    local arg
    for arg in "$@" ; do
        case "$arg" in
            --lang=*) ;;                                             # already handled
            --connect-header) connect_header_with_kernel=yes ;;
            --no-progress) progress=no ;;
            --scroll) scroll=yes ;;
            --small) small_font=yes ;;
            --debug) debug=yes ;;
            -q | --quiet) quiet=yes ;;
            -h | --help)
                cat <<EOF >&2
Usage: $progname [options]
options:
    --connect-header      Make kernel and header package go together at install or uninstall.
    --scroll              Enable scrolling in the kernel info window. Useful if additional kernels are available.
    --lang=*              Prefer the given target language '*'.
    --small               Make the akm window smaller, meant for helping with small displays at 1366x768 resolution.
    --quiet | -q          Be less verbose.
    --no-progress         Don't show the progress window.
    --help | -h           This help.
EOF
                exit 0
                ;;
            -*) DIE "unsupported option '$arg'" ;;
            *) DIE "unsupported parameter '$arg'" ;;
        esac
    done
}

AvailableKernelsAndHeaders() {

    # Find kernel packages by finding packages which have words 'linux' and 'headers'.
    # From the output of 'pacman -Sl'
    # - find lines that have words: 'linux' and 'headers'
    # - drop lines containing 'testing' (=testing repo, causes duplicates) and 'linux-api-headers' (=not a kernel header)
    # - show the (header) package names
    # Now we have names of the kernel headers.
    # Then add the kernel packages to proper places and output the result.
    # Then display possible kernels and headers added by the user.

    # The output consists of a list of reponame and a package name formatted as: "reponame/pkgname"
    # For example:
    #    reponame/linux-xxx reponame/linux-xxx-headers
    #    reponame/linux-yyy reponame/linux-yyy-headers
    #    ...

    local header
    local kernel
    local pacman=/usr/bin/pacman
    local headers
    headers=$(expac -Ss '%r/%n' 'linux[-]*[^ pi]*-headers' | grep -Pv 'testing/linux-')    # 'pi' removes all 'linux-api-headers'

    # Get kernel names from header names and display them all
    for header in $headers ; do
        kernel=${header%-headers}
        echo -e "$kernel\n$header"
    done

    # Display kernels added by the user
    [ "${akm_kernels_headers_user[0]}" ] && echo "${akm_kernels_headers_user[@]}"
}

RepoType() {
    pacman-conf --repo-list | grep "\-testing$" >/dev/null && echo "Testing" || echo "Stable"
}

Main() {
    local progname="${0##*/}"
    local quiet=no
    local debug=no
    declare -A LocalPkgVersions=()
    local language=""

    if [[ "$*" =~ "--lang=" ]] ; then
        language=$(printf "%s\n" "$@" | grep -- "--lang=" | tail -n1 | sed 's|--lang=||')
    fi

    source /usr/share/endeavouros/translations/bash-app-translate "" "$language" || exit 1

    CommonStuff                   # fetches common bash definitions
    eos_assert_deps "$progname" yad || return 1
    Main2 "$@"
}

Main2() {
    local pacman=/usr/bin/pacman
    local na="(-)"
    local kernels=()
    local connect_header_with_kernel=no    # default, change with option --connect-header
    local akm_kernels_headers_user=()
    local akm_window_width=900
    local scroll=yes
    local small_font=no                    # yes = suitable for a small window, like 1366x768 resolution
    local smallBegin=""
    local smallEnd=""
    local nrofkernelitems                  # 8 with only upstream kernels
    local RepoType
    local progress=yes

    DebugBreak

    RepoType=$(RepoType)

    AkmConfig "$@"

    if [ "$small_font" = "yes" ] ; then
        smallBegin="<small>"
        smallEnd="</small>"
    fi

    Verbose2 "==> Info: detecting available kernel packages."
    readarray -t kernels < <(AvailableKernelsAndHeaders)

    local functions=(  # order is important!
        Choose
        PkgName
        Installed
        Stable
        Testing
        KernelOrg
        KOVersion
    )

    nrofkernelitems=${#kernels[@]}
    [ "$nrofkernelitems" -gt 8 ] && scroll=yes

    local URL_timeout="--max-time 30"                      # used for all curl calls here

    local URL="https://www.kernel.org"
    local kernelorg=""
    local org_kernels=(mainline stable longterm linux-next)
    local KOName=$(BTR akm_title_koname)           # "K.o.category"
    local KOVersionName=$(BTR akm_title_kovname)   # "K.o.version"
    local xx
    local titles=() title
    local t1=""

    DebugBreak

    t1+="$smallBegin"
    t1+="$(BTR t1a_str "$progname")"
    if [ "$small_font" = "no" ] ; then
        for title in akm_title_choose akm_title_pkgname akm_title_installed akm_title_stable akm_title_testing ; do
            titles+=("$(BTR "$title")")
        done
        t1+="$(BTR t1b_str "${titles[@]}" "$KOName" "$KOVersionName")"
    fi
    t1+="$(BTR t1c_str "$na" "/etc/$progname.conf")"
    t1+="$smallEnd"

    local -r yad_s_chl="firefox '$(eos-github2gitlab 'https://github.com/endeavouros-team/PKGBUILDS/commits/master/akm')'"
    local -r yad_s_man="eos-apps-info-helper akm"

    local cmd=(
        eos_yad
        --width="$akm_window_width"
        --use-interp
        --form --title="$(BTR yad_s_title)" --columns=${#functions[@]}
        --text="$t1"
        --image="$ICO_UPDATE"
        --button=" ${smallBegin}$(BTR yad_s_chl)${smallEnd}!applications-development!$(BTR yad_s_chltip)":"Changelog"
        --button=" ${smallBegin}$(BTR yad_s_man)${smallEnd}!help-contents!$(BTR yad_s_mantip "$progname")":"Manual"
        --button=" ${smallBegin}$(BTR yad_s_cancel)${smallEnd}!gtk-cancel!$(BTR yad_s_no_change)":1
        --button=" ${smallBegin}$(BTR yad_s_run)${smallEnd}!system-run!$(BTR yad_s_make_change)":0
    )
    if [ "$scroll" = "yes" ] ; then
        cmd+=(--scroll --height=700)   # 660 is about the default
    fi

    local progress_cmd=(
        eos_yad --progress --enable-log --log-on-top --log-expanded --log-height 150 --auto-close
        --width=400 --no-buttons
        --image="$ICO_INFO"
        --title="$(BTR proc_title)"
        --text="$(BTR proc_text)"
    )
    local ix=1 count=${#functions[@]} val
    local cmdfile
    cmdfile="$(mktemp "$HOME/.cache/akm.tmp.XXXXX")"    # will gather the whole value of 'cmd' into this file (used due to the progress window)

    if [ -z "$kernelorg" ] ; then
        local errcode=0
        # shellcheck disable=2086
        kernelorg="$(/usr/bin/curl --fail -Ls $URL_timeout "$URL")" || errcode=$?
        case $errcode in
            0) ;;
            *) eos-connection-checker || DIE "$(BTR die_net_fail)" && UNAVAILABLE "$URL" ;;
        esac
        test -n "$kernelorg" || DIE "$(BTR die_curl_fail "$URL")"
    fi

    DebugBreak

    RunWithProgressOrNot
    
    local install=() uninstall=() pkg partner result result1="" retval

    result="$("${cmd[@]}")"
    retval=$?

    [ $retval -ne 0 ] && return
    test -z "$result" && return

    if true ; then
        # For some users the yad output contains 2 lines instead of one ... ???
        if [ "$(echo "$result" | wc -l)" != "1" ] ; then
            Printf2 $(BTR warn_odd_problem1 "$result")  # "==> Warning: yad output should have been exactly one line, but is:\n'$result'\n"
            result1="$result"
            result="$(echo "$result" | tail -n1)"
            Printf2 $(BTR warn_odd_problem2 "$result")  # "==> Warning: using the last line:\n'$result'\n"
        fi
        if [ "$(echo "$result" | wc -l)" != "1" ] ; then
            DIE $(BTR die_parse_error "$result1")       # "cannot parse yad output:\n'$result1'\n"
        fi
    fi

    result="${result:1}"                               # skip first LBL field !!

    declare -A pkgstatus
    for ((ix=0; ix < ${#kernels[@]}; ix++)) ; do
        pkg="${kernels[$ix]}"
        pkgstatus[$pkg]="$(echo "$result" | cut -d '|' -f $((ix+1)))"   # TRUE or FALSE

        if [ "$connect_header_with_kernel" = "yes" ] ; then

            # Note: a kernel may have TRUE but header FALSE!
            # When connecting header with kernel this may conflict.
            # To solve this, assume kernel value is stronger.
            # Remember that the kernel value exists because it is set
            # before the header value in the local variable 'kernels' above.

            case "$pkg" in
                *-headers)
                    partner="${pkg%-headers}"
                    pkgstatus[$pkg]="${pkgstatus[$partner]}"  # kernel value overrides the header value!
                    ;;
            esac
        fi
    done

    for ((ix=0; ix < ${#kernels[@]}; ix++)) ; do
        pkg="${kernels[$ix]}"
        if [ "$connect_header_with_kernel" = "yes" ] ; then
            case "$pkg" in
                *-headers) partner="${pkg%-headers}" ;;
                *)         partner="$pkg"-headers    ;;
            esac
        fi

        case "${pkgstatus[$pkg]}" in
            TRUE)
                [ -z "$(LocalVersion "$pkg")" ] && install+=("$pkg")
                if [ "$connect_header_with_kernel" = "yes" ] ; then
                    [ -z "$(LocalVersion "$partner")" ] && install+=("$partner")
                fi
                ;;
            FALSE)
                [ "$(LocalVersion "$pkg")" ] && uninstall+=("${pkg##*/}")
                if [ "$connect_header_with_kernel" = "yes" ] ; then
                    [ "$(LocalVersion "$partner")" ] && uninstall+=("${partner##*/}")
                fi
                ;;
        esac
    done

    UniqueArr install
    UniqueArr uninstall

    cmd=()
    # shellcheck disable=2206
    test -n "${uninstall[0]}" && cmd+=("$pacman" -Rsn ${uninstall[*]} ";")
    # shellcheck disable=2206
    test -n "${install[0]}"   && cmd+=("$pacman" -S   ${install[*]}   ";")

    if [ -n "${cmd[0]}" ] ; then
        case "$pacman" in
            yay | paru | /usr/bin/yay | /usr/bin/paru)
                RunInTerminal "echo '${cmd[*]}' ; ${cmd[*]}"
                ;;
            pacman | /usr/bin/pacman)
                RunInTerminal "echo '${cmd[*]}' ; $EOS_ROOTER '${cmd[*]}'"
                ;;
        esac
    fi
}

RunWithProgressOrNot() {
    local func1

    case "$progress" in
        no)
            for func1 in "${functions[@]}" ; do
                $func1 || DIE $(BTR die_func_fail "$func1")        # run each function to add stuff to the '$cmd'
            done
            ;;
        yes)
            {
                for func1 in "${functions[@]}" ; do
                    $func1 || DIE $(BTR dis_func_fail "$func1")    # run each function to add stuff to the '$cmd'
                    val="$(( ix < count ? ix*100/count : 99 ))"    # progress window stuff
                    ((ix++))
                    printf "#%s\n%s\n" "$func1" "$val"
                done
                printf "%s\n" "${cmd[@]}" > "$cmdfile"              # now print the gathered value of 'cmd' into $cmdfile
                printf "#===> $(BTR msg_progress_done)\n100\n"      # stop the progress window
            } | "${progress_cmd[@]}"

            readarray -t cmd < <(cat "$cmdfile")                    # now get the full 'cmd' from the file
            rm -f "$cmdfile"
            ;;
    esac
}

DebugBreak() {
    if [ $debug = yes ] ; then
        :                        # add breakpoint to this line!
    fi
}

Main "$@"
