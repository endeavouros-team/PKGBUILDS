#!/bin/bash
# Maintainer: manuel (see forum.endeavouros.com)

pkgname=eos-manual-intervention
pkgdesc="Manual interventions manager."
url="https://github.com/endeavouros-team/PKGBUILDS/raw/master/$pkgname"
pkgver=0.26
pkgrel=1
arch=('any')
license=('GPL')

# either curl or wget is required:
optdepends=("curl: for fetching files"
            "wget: for fetching files")

source=(
    $url/$pkgname
    $url/$pkgname.interventions
)
sha512sums=('025be05812d954f7bed94f0cc087c4884a9fe49e0d39bf4cb28120a938b4edacd657d95f935f43cef963d6a7cc23793af9a70d53a96da3017305d6c90b73b716'
            'e78a5f4f684c6eccb3c6e311991949429ac51d79f0979b2b84e4ee46ca8f2d3a7311991e69eb44503fbe3b48c2c895e3f6d7a3805f8e099ce34be40070c4ed67')

package() {
    install -Dm755 "$pkgname"                "$pkgdir/usr/bin/$pkgname"
    install -Dm644 "$pkgname.interventions"  "$pkgdir/etc/$pkgname.interventions"  # fallback!
}
